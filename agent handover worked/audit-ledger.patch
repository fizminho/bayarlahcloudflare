+  assert.equal(validateDecisionPayload(decision({ decision: "OVERRIDE", classification: "made_up" })).ok, false);
+  assert.equal(validateDecisionPayload(decision({ decision: "OVERRIDE", classification: "conventional_debt" })).ok, true);
